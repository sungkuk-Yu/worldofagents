{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "outDir": "dist-test-unit",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "tests/unit/**/*.ts",
    "src/lib/gesture.ts",
    "src/lib/joystickMapping.ts",
    "src/lib/joystickEngine.ts",
    "src/lib/joystickMode.ts",
    "src/lib/userPrefs.ts",
    "src/lib/chatLogic.ts",
    "src/lib/layout.ts",
    "src/lib/deviceLabel.ts",
    "src/lib/pttLogic.ts",
    "src/lib/resumeLogic.ts",
    "src/lib/inspectStore.ts",
    "src/hooks/useChatSession.ts",
    "src/hooks/usePushToTalk.ts",
    "src/lib/secureStorage.ts",
    "src/lib/richtext.ts",
    "src/lib/vaultLogic.ts",
    "src/lib/kanbanLogic.ts",
    "src/lib/formLogic.ts",
    "src/lib/chartLogic.ts",
    "src/lib/legalDocLogic.ts",
    "src/lib/legalDocs.ts",
    "src/cards/payload.ts",
    "src/cards/preview.ts",
    "src/cards/expandStore.ts",
    "src/neurons/DialogTypeClassifier.ts",
    "src/neurons/NeuronOrchestrator.ts",
    "src/store/index.ts",
    "src/types/index.ts"
  ]
}
