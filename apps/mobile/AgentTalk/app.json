{
  "expo": {
    "name": "AgentTalk",
    "slug": "AgentTalk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "agenttalk",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.worldofagents.agenttalk",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "에이전트에게 음성으로 명령하려면 마이크 접근이 필요합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.worldofagents.agenttalk",
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "에이전트에게 음성으로 명령하려면 마이크 접근이 필요합니다."
        }
      ]
    ]
  }
}
