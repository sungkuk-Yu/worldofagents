# Server Configuration
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:8081,http://localhost:5173

# Supabase (필수)
# https://supabase.com/dashboard 에서 프로젝트 생성 후 설정값 확인
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stream Chat (선택 - 실시간 채팅 기능)
# https://getstream.io/dashboard 에서 API 키 발급
STREAM_CHAT_API_KEY=your-stream-api-key
STREAM_CHAT_API_SECRET=your-stream-api-secret

# OpenAI (선택 - Whisper STT 기능)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# JWT Secret (개발 환경에서만 기본값 사용)
JWT_SECRET=your-secure-jwt-secret-change-in-production

# 개발 모드 (DEV_MODE=true면 Supabase 없이도 서버 시작 가능)
DEV_MODE=false

# 채팅 LLM 설정 (키는 로컬 환경에서만 입력)
CHAT_LLM_API_KEY=
DASHSCOPE_API_KEY=
# CHAT_LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# CHAT_LLM_MODEL=qwen3-max
# CHAT_LLM_MAX_TOKENS=1024
# CHAT_LLM_TIMEOUT_MS=60000
# CHAT_LLM_TEMPERATURE=0.8
# CHAT_LLM_ENABLE_THINKING=false
# CHAT_LLM_HISTORY_TURNS=20
# CHAT_LLM_DISABLED=false

# LLM 비상전원 (t_67eaf475) — 전원(DashScope) 장애 시 자동 전환하는 두번째 프로바이더.
# 키를 설정하면 풀에 추가된다. → 차 ‘CHAT_LLM_FB_KEY’ (호환모드 chat/completions → 고객 사이트로 전환).
CHAT_LLM_FB_KEY=

# Perplexity Sonar 검색 그라운딩 (법률·회계 등 전문가 카테고리 답변에 검색+출처 주입)
# https://perplexity.ai/account/api — 키 없으면 그라운딩 생략(기존 동작)
PERPLEXITY_API_KEY=

# 요청 언어가 없거나 미지원일 때 사용할 기본 언어 (ko 또는 en)
DEFAULT_LOCALE=ko
# 원문 음성 전사 보존 일수. MVP는 정책 선언만, 자동 삭제 크론은 Phase 3.
# 회원탈퇴 시에는 이 기간과 무관하게 즉시 파기한다.
RAW_TRANSCRIPT_RETENTION_DAYS=180

# 첨부 업로드 (t_401c5bd1) — POST /api/upload → Supabase Storage 버킷 attachments.
# 파일당 상한(bytes, 기본 20MB), 사용자당 UTC 일일 개수(기본 50), 버킷명, MIME allowlist.
# DEV_MODE에서는 Storage 대신 인메모리 devstore.blobs에 저장된다(신규 서비스 가입 불필요).
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_PER_DAY=50
UPLOAD_BUCKET=attachments
UPLOAD_ALLOWED_MIMES=image/*,application/pdf

# context_patches 콜드 아카이브 (t_848d0c3b — 마이그레이션 016, 설계 볼트 10-01).
# 기본 OFF: timer/스크립트가 켜져 있어도 enabled=false면 dry-run만 한다. 실 execution은
# 김비서 첫 배치 결재(DELETE 예외 조항) 후 deploy.env에서만 켠다 (git에 커밋 금지).
# HOT_WINDOW/SAFETY_LAG: cold 후보 창(일/시간). MAX_BATCHES: 1회 실행 배치 캡.
# CONTEXT_ARCHIVE_ENABLED=true
# CONTEXT_PATCH_HOT_DAYS=90
# CONTEXT_ARCHIVE_SAFETY_LAG_HOURS=24
# CONTEXT_ARCHIVE_BUCKET=context-archive
# CONTEXT_ARCHIVE_MAX_BATCHES=50

# 공감 확인음+답변 리드 / 질문 큐 / 후속 질문 (t_344e047a, 대표님 9/28)
# ANSWER_LEAD_MS: 짧은 확인음 노출 후 답변 스트리밍 시작 전 체감 공백 ms (기본 3000, 0=즉시).
# QUEUE_MAX_PENDING: 세션 질문 큐 대기 상한(기본 20) / QUEUE_MAX_BATCH: 드레인 1라운드 처리 캡(기본 5).
# SUGGEST_QUESTIONS_DISABLED=true면 후속 예상 질문 생성 OFF. 전제: 마이그레이션 008 message_queue 적용.
# ANSWER_LEAD_MS=3000
# QUEUE_MAX_PENDING=20
# QUEUE_MAX_BATCH=5
# SUGGEST_QUESTIONS_DISABLED=false
# SUGGEST_QUESTIONS_TIMEOUT_MS=6000
