{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "project": "AgentTalk (에이전트톡) — 월드오브에이전트",
    "version": "1.1.0",
    "updated": "2026-09-25",
    "basis": "worldofagents-whitepaper.md / agenttalk-modern-ux-plan.md / dialogue-functionality-spec.md / ui-interaction-spec.md",
    "mode": "light-primary",
    "theme": "라이트 모드 — 흰 바탕 + 그린 포인트 (참고 톤: 삼성 헬스 / 네이버페이 / 토스)",
    "device": "mobile 390x844 · tablet 768x1024 · desktop 1440x900",
    "import": "Figma에서 Design Tokens 플러그인 또는 수동 변수로 로드"
  },
  "color": {
    "bg":           { "value": "#F5F7FA", "type": "color", "description": "앱 배경 — 라이트(흰 바탕 계열)" },
    "surface":      { "value": "#FFFFFF", "type": "color", "description": "카드 표면 — 화이트" },
    "surface-raise":{ "value": "#F0F3F7", "type": "color", "description": "상승 표면(hover/selected/참조바)" },
    "surface-hover":{ "value": "#EAEEF3", "type": "color" },
    "overlay":      { "value": "rgba(17,24,39,0.40)", "type": "color", "description": "오버레이/백드롭 (라이트)" },
    "border":       { "value": "#E4E8EE", "type": "color" },
    "border-strong":{ "value": "#CBD3DD", "type": "color" },
    "text-1":       { "value": "#1A1D26", "type": "color", "description": "1차 텍스트 (다크)" },
    "text-2":       { "value": "#5A6472", "type": "color", "description": "2차 텍스트" },
    "text-3":       { "value": "#8F98A6", "type": "color", "description": "3차/힌트 텍스트" },
    "accent-primary":{"value": "#00A86B", "type": "color", "description": "메인 액센트 — 그린 · 상호작용/포커스" },
    "on-primary":   { "value": "#FFFFFF", "type": "color" },
    "seg-info":     { "value": "#0891B2", "type": "color", "description": "세그먼트·정보 (라이트 모드 대응)" },
    "seg-data":     { "value": "#7C5CE0", "type": "color", "description": "세그먼트·데이터 (라이트 모드 대응)" },
    "seg-file":     { "value": "#E8912D", "type": "color", "description": "세그먼트·파일 (라이트 모드 대응)" },
    "seg-task":     { "value": "#16A34A", "type": "color", "description": "세그먼트·작업 (라이트 모드 대응)" },
    "seg-multi":    { "value": "#F43F5E", "type": "color", "description": "세그먼트·멀티에이전트 (라이트 모드 대응)" },
    "status-ok":    { "value": "#16A34A", "type": "color" },
    "status-warn":  { "value": "#D97706", "type": "color" },
    "status-err":   { "value": "#DC2626", "type": "color" },
    "status-neutral":{"value": "#6B7280", "type": "color", "description": "막힘 상태는 경고색이 아닌 중립 회색" }
  },
  "radii": {
    "xs": { "value": "4px", "type": "borderRadius" },
    "sm": { "value": "6px", "type": "borderRadius" },
    "md": { "value": "8px", "type": "borderRadius", "description": "카드 기본(사각형)" },
    "lg": { "value": "12px", "type": "borderRadius", "description": "히어로/결과 카드" },
    "full": { "value": "999px", "type": "borderRadius", "description": "칩/아바타/토글" }
  },
  "spacing": {
    "sp-1": { "value": "4px", "type": "spacing" },
    "sp-2": { "value": "8px", "type": "spacing" },
    "sp-3": { "value": "12px", "type": "spacing" },
    "sp-4": { "value": "16px", "type": "spacing" },
    "sp-5": { "value": "20px", "type": "spacing" },
    "sp-6": { "value": "24px", "type": "spacing" },
    "sp-8": { "value": "32px", "type": "spacing" },
    "sp-10": { "value": "40px", "type": "spacing" }
  },
  "typography": {
    "display": { "value": "700 34px/1.15", "type": "typography", "font": "-apple-system BlinkMacSystemFont SF Pro Text SF Pro KR Apple SD Gothic Neo Pretendard Noto Sans KR Roboto" },
    "title-1": { "value": "700 28px/1.2", "type": "typography" },
    "title-2": { "value": "700 22px/1.25", "type": "typography" },
    "headline": { "value": "600 17px/1.3", "type": "typography" },
    "body":     { "value": "400 15px/1.5", "type": "typography" },
    "body-bold":{ "value": "600 15px/1.4", "type": "typography" },
    "subhead":  { "value": "500 13px/1.45", "type": "typography" },
    "caption":  { "value": "500 12px/1.4", "type": "typography" },
    "micro":    { "value": "500 11px/1.3", "type": "typography" }
  },
  "shadows": {
    "sh-1": { "value": "0 1px 2px rgba(16,24,40,0.06)", "type": "boxShadow" },
    "sh-2": { "value": "0 4px 14px rgba(16,24,40,0.08)", "type": "boxShadow" },
    "sh-3": { "value": "0 12px 32px rgba(16,24,40,0.12)", "type": "boxShadow" }
  },
  "component-tokens": {
    "joystick": {
      "diameter-ratio": "22% of viewport width (min 80px, max 140px)",
      "deadzone-px": "12",
      "direction-threshold-px": "30",
      "angle-snap-deg": "22.5",
      "long-press-ms": "500",
      "tap-max-ms": "200",
      "haptic": "light, on direction + release",
      "states": ["idle(pulse 2s)", "press(+10% bg)", "direction-lock(arrow+label)", "recording(red)"]
    },
    "segment-history-bar": {
      "position": "bottom fixed rail (mobile), above follow-up mic",
      "node-width": "56px",
      "connector": "12px 1.5px line, done=segment color 55%",
      "states": ["empty", "single", "connected(past→current)", "full 5-type", "overflow(+N)", "long-press delete"],
      "behavior": "tap=restore stack entry, long-press=close, left/right swipe=paging, >10 auto archive to favorites"
    },
    "segments": {
      "types": ["information", "data", "file", "task", "multi-agent"],
      "icon-set": "stroke 1.8, 24px grid; small tile 24px, card tile 34px",
      "identity-color-usage": "icon/border/glow only, never full-bleed"
    }
  }
}